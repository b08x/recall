# RECALL Configuration

# Path settings (expanduser will be used)
# NOTEBOOK_PATH=~/Notebook
# WORKSPACE_PATH=~/Workspace

# DSPy settings
# DSPY_PROVIDER=openrouter
# DSPY_INSIGHTS_PROVIDER=openai  # Optional: specific provider for insights analysis
# DSPY_MODEL=openai/gpt-4o-mini
# DSPY_INSIGHTS_MODEL=openai/gpt-4o  # Optional: specific model for insights analysis

# API Keys (uncomment and fill)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-v1-...
# GEMINI_API_KEY=AIzaSy...
# MISTRAL_API_KEY=your_mistral_api_key

# Platform specific
# GITHUB_TOKEN=github_pat_...

# Rate Limiting & Retry
# RETRY_MAX_ATTEMPTS=5
# RETRY_MIN_WAIT=1.0
# RETRY_MAX_WAIT=60.0
# REQUESTS_PER_MINUTE=20

# Context Enhancement Settings
# ENABLE_CONTEXT_ENHANCEMENT=true
# CONTEXT_SOURCES=obsidian,git
# MAX_CONTEXT_MATCHES_PER_SOURCE=3
# CONTEXT_RELEVANCE_THRESHOLD=0.7
# CONTEXT_ENHANCEMENT_TIMEOUT=30.0
